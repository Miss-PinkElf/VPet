    {
      "id": "sequence-thinking-walk-think",
      "category": "sequence",
      "title": "思考 -> 移动 -> 说话 -> 恢复",
      "description": "当前阶段第一条核心 4 步长链路。",
      "goal": "确认后端编排 -> 前端执行 -> 状态回传这一整条链路可解释。",
      "pass_criteria": [
        "时间线能读出 mode.switch -> window.move -> bubble.show -> mode.switch",
        "last_event_at 可区分事件消费时间",
        "整体体感稳定"
      ],
      "payload": {
        "name": "thinking-walk-speak-normal",
        "steps": [
          {
            "event": {
              "type": "mode.switch",
              "mode": "thinking"
            }
          },
          {
            "event": {
              "type": "window.move",
              "dx": 90,
              "dy": -20,
              "style": "smart"
            },
            "wait_for": "move_complete",
            "wait_timeout_ms": 5000,
            "settle_ms": 120
          },
          {
            "event": {
              "type": "bubble.show",
              "text": "我先想一下，再边移动边回答。",
              "duration_ms": 5000,
              "graph": "think"
            }
          },
          {
            "event": {
              "type": "mode.switch",
              "mode": "normal"
            }
          }
        ]
      },
      "result": {
        "status": "mixed",
        "note": "确实做了，但是有点快，有点重合了",
        "updated_at": "2026-03-28T13:47:28.558Z"
      }
    },
    {
      "id": "sequence-bubble-move-touch-recover",
      "category": "sequence",
      "title": "说话 -> 移动 -> 摸头 -> 恢复",
      "description": "当前阶段第二条核心 4 步长链路。",
      "goal": "确认 bubble / move / motion 的组合链路稳定。",
      "pass_criteria": [
